<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#10213b">
  <meta name="description" content="Turno Fácil: controla tus jornadas, horas y propinas.">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" href="icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
  <title>Turno Fácil</title>
</head>
<body>
  <header class="topbar">
    <div class="brand"><span class="brand-mark">TF</span><div><strong>Turno Fácil</strong><small>Tu trabajo, bajo control</small></div></div>
    <button id="settingsBtn" class="icon-btn" aria-label="Configuración">⚙</button>
  </header>

  <main>
    <section class="panel" id="salaryPanel">
      <h2>💶 Calculadora de sueldo</h2>
      <label>Sueldo mensual bruto (€)
        <input id="salaryBase" type="number" min="0" placeholder="1500">
      </label>
      <label>Horas extras
        <input id="salaryExtraHours" type="number" min="0" value="0">
      </label>
      <label>Precio hora extra (€)
        <input id="salaryExtraRate" type="number" min="0" placeholder="12">
      </label>
      <button id="salaryCalculate" class="primary" type="button">Calcular sueldo</button>
      <div id="salaryResult" class="result-box">Introduce tus datos.</div>
    </section>

    <section class="panel" id="calendarPanel">
      <h2>📅 Calendario de turnos</h2>
      <form id="calendarForm">
        <label>Fecha
          <input id="calendarDate" type="date" required>
        </label>
        <label>Turno
          <select id="calendarType">
            <option>Mañana</option>
            <option>Tarde</option>
            <option>Noche</option>
            <option>Descanso</option>
            <option>Vacaciones</option>
          </select>
        </label>
        <label>Entrada
          <input id="calendarStart" type="time" value="09:00">
        </label>
        <label>Salida
          <input id="calendarEnd" type="time" value="17:00">
        </label>
        <button class="primary" type="submit">Guardar turno</button>
      </form>
      <div id="calendarList"></div>
    </section>

    <section class="panel" id="splitTipsPanel">
      <h2>💰 Repartir propinas</h2>
      <label>Total de propinas (€)
        <input id="splitTipsTotal" type="number" min="0" step="0.01" placeholder="100">
      </label>
      <label>Número de trabajadores
        <input id="splitTipsPeople" type="number" min="1" step="1" placeholder="4">
      </label>
      <button class="primary" id="splitTipsCalculate" type="button">Repartir propinas</button>
      <div id="splitTipsResult"></div>
    </section>

    <section class="welcome">
      <p class="eyebrow" id="todayLabel">TU RESUMEN</p>
      <h1>Hola, <span id="userName">compañero</span> 👋</h1>
      <p class="muted">Aquí tienes el resumen de tu trabajo.</p>
    </section>

    <section class="stats">
      <article class="stat-card"><span>Horas este mes</span><strong id="monthHours">0 h</strong><small>Jornadas registradas</small></article>
      <article class="stat-card"><span>Sueldo estimado</span><strong id="monthPay">0,00 €</strong><small>Según tu tarifa por hora</small></article>
      <article class="stat-card"><span>Propinas</span><strong id="monthTips">0,00 €</strong><small>Este mes</small></article>
    </section>

    <section class="panel shift-panel">
      <div class="section-heading"><div><p class="eyebrow">CONTROL HORARIO</p><h2>Tu jornada</h2></div><span class="live-dot" id="statusDot"></span></div>
      <div class="timer" id="timer">00:00:00</div>
      <p class="muted center" id="shiftStatus">Todavía no has iniciado tu jornada.</p>
      <div class="actions">
        <button id="startBtn" class="primary">▶ Registrar entrada</button>
        <button id="stopBtn" class="secondary" disabled>■ Registrar salida</button>
      </div>
      <p class="hint">Recuerda registrar tu descanso y comprobar tus horas antes de cerrar el día.</p>
    </section>

    <section class="panel">
      <div class="section-heading"><div><p class="eyebrow">AÑADIR REGISTRO</p><h2>Propinas de hoy</h2></div><span class="emoji">💶</span></div>
      <form id="tipsForm" class="inline-form">
        <label class="sr-only" for="tipsInput">Importe de propinas en euros</label>
        <input id="tipsInput" type="number" min="0" step="0.01" placeholder="Importe en €" required>
        <button class="primary" type="submit">Guardar</button>
      </form>
    </section>

    <section class="panel">
      <div class="section-heading"><div><p class="eyebrow">TU ACTIVIDAD</p><h2>Últimas jornadas</h2></div></div>
      <div id="history" class="history"><p class="empty">Todavía no hay jornadas guardadas.</p></div>
    </section>

    <section class="panel">
      <div class="section-heading"><div><p class="eyebrow">CONFIGURA TU PERFIL</p><h2>Tus datos</h2></div></div>
      <form id="profileForm" class="profile-form">
        <label>Tu nombre<input id="nameInput" maxlength="30" placeholder="Ej. Alex"></label>
        <label>Pago bruto estimado por hora (€)<input id="rateInput" type="number" min="0" step="0.01" placeholder="Ej. 10"></label>
        <button class="secondary" type="submit">Guardar mis datos</button>
      </form>
      <p class="hint">El sueldo es una estimación orientativa, no sustituye a tu nómina ni calcula impuestos, complementos o convenios.</p>
    </section>

    <section class="panel" id="backupPanel">
      <div class="section-heading">
        <div>
          <p class="eyebrow">TUS DATOS</p>
          <h2>💾 Copia de seguridad</h2>
        </div>
      </div>

      <p class="hint">
        Guarda una copia de tus jornadas, perfil, propinas y calendario.
        Si cambias de móvil, podrás recuperarlos.
      </p>

      <div class="backup-actions">
        <button class="primary" id="backupExport" type="button">
          Descargar copia de seguridad
        </button>

        <label class="backup-file">
          Restaurar una copia guardada
          <input id="backupImport" type="file" accept="application/json,.json">
        </label>
      </div>

      <p class="hint" id="backupMessage" aria-live="polite">
        La copia se guarda en un archivo de tu dispositivo.
      </p>
    </section>
  </main>

  <footer>Turno Fácil · Primera versión · Tus datos se guardan en este dispositivo.</footer>

  <dialog id="settingsDialog">
    <form method="dialog" class="dialog-content">
      <h2>Configuración</h2>
      <p>Esta primera versión guarda tus datos localmente en este navegador. Si borras los datos del navegador, podrías perderlos.</p>
      <button class="primary" value="close">Entendido</button>
    </form>
  </dialog>
  <script src="app.js"></script>
</body>
</html>
